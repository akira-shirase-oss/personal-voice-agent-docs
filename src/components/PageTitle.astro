---
/**
 * The page title, plus the page's own Markdown: "Copy Markdown" puts it on the clipboard (for an AI
 * assistant or an issue), and "View as Markdown" opens the plain file (`/<page>.md`; the changelog
 * has one too).
 */
import Default from '@astrojs/starlight/components/PageTitle.astro';

const route = Astro.locals.starlightRoute;
const id = route.entry?.id;
// The home page's route id is empty; the changelog has a Markdown copy of its own.
const mdHref = id === undefined ? undefined : `/${id === '' || id === 'index' ? 'index' : id}.md`;
---

<Default />
{
	mdHref && (
		<div class="page-actions not-content print:hidden">
			<button type="button" class="page-action" data-copy-md={mdHref}>
				<svg aria-hidden="true" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<rect x="9" y="9" width="12" height="12" rx="2" />
					<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
				</svg>
				<span data-label>Copy Markdown</span>
			</button>
			<a class="page-action" href={mdHref}>
				<svg aria-hidden="true" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
					<path d="M14 2v6h6" />
				</svg>
				View as Markdown
			</a>
		</div>
	)
}

<script>
	for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-md]')) {
		const label = button.querySelector('[data-label]');
		button.addEventListener('click', async () => {
			try {
				const response = await fetch(button.dataset.copyMd ?? '');
				if (!response.ok) throw new Error(String(response.status));
				await navigator.clipboard.writeText(await response.text());
				if (label) label.textContent = 'Copied';
			} catch {
				if (label) label.textContent = 'Copy failed: use View as Markdown';
			}
			setTimeout(() => {
				if (label) label.textContent = 'Copy Markdown';
			}, 2500);
		});
	}
</script>

<style>
	.page-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 0.75rem;
	}
	.page-action {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		font: inherit;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-2);
		background: transparent;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.375rem;
		padding: 0.25rem 0.625rem;
		cursor: pointer;
		text-decoration: none;
		line-height: 1.5;
	}
	.page-action:hover {
		color: var(--sl-color-white);
		border-color: var(--sl-color-gray-4);
	}
</style>
